# Copy this file to .env.development / .env.qa / .env.production / .env.test
# and fill in real values. The app validates these at startup (src/config/env.ts).

# development | test | qa | production  (normally set by the npm script, not here)
NODE_ENV=development
PORT=4000

# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# In production add ?sslmode=require (or your provider's SSL settings).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inventory_dev?schema=public
DB_POOL_MAX=10

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Comma-separated list of frontend URLs allowed to call the API (React dev server = 5173 for Vite)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Max requests per IP per window
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Serve interactive API docs at /api-docs
SWAGGER_ENABLED=true

# Number of proxies in front of the app (load balancer / nginx). 0 when running locally.
TRUST_PROXY=0
