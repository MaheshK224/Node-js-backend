// Prisma schema: the single source of truth for the database structure.
// After changing this file run `npm run db:migrate -- --name <change_name>`.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

// The connection URL lives in prisma.config.ts (Prisma 7+), not here.
datasource db {
  provider = "postgresql"
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(100)
  description String?   @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  products    Product[]

  // Model names are PascalCase in code, tables are snake_case in Postgres.
  @@map("categories")
}

model Product {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(150)
  sku         String    @unique @db.VarChar(50)
  description String?   @db.VarChar(1000)
  // Never use Float for money; Decimal keeps exact values.
  price       Decimal   @db.Decimal(12, 2)
  stock       Int       @default(0)
  isActive    Boolean   @default(true) @map("is_active")
  categoryId  String    @map("category_id") @db.Uuid
  // Restrict: a category cannot be deleted while products reference it.
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  // Soft delete: rows are never physically removed, only marked.
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([categoryId])
  @@index([deletedAt])
  @@map("products")
}
